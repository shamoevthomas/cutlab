{
  "name": "cutlab",
  "private": true,
  "version": "0.1.0",
  "description": "CutLab: personal video editor (rebuild of CapCut desktop features)",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "vite build && electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env CUTLAB_DEV=1 electron .\"",
    "dist:mac": "vite build && electron-builder --mac",
    "test": "vitest run",
    "e2e": "playwright test",
    "tokens": "node scripts/tokens.mjs",
    "contrast": "python3 ~/.claude/skills/replica-design/contrast.py replica/design/tokens.json",
    "postinstall": "node scripts/copy-runtime.mjs",
    "prebuild": "node scripts/copy-runtime.mjs",
    "dist:win": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.teka.cutlab",
    "productName": "CutLab",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "icon": "build/icon.png",
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "CutLab",
      "artifactName": "CutLab-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CutLab-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.2",
    "@mediapipe/tasks-vision": "^0.10.18",
    "ffmpeg-static": "^5.2.0",
    "immer": "^10.1.1",
    "lucide-react": "^0.453.0",
    "mp4-muxer": "^5.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "ffprobe-static": "^3.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "author": {
    "name": "Thomas Shamoev"
  }
}
